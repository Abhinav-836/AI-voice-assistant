# =============================================================================
# AI Voice Assistant - Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR API KEYS BEFORE RUNNING.
# NEVER COMMIT YOUR REAL .env FILE TO VERSION CONTROL.
# =============================================================================

# =============================================
# Rime TTS (spoken output)
# https://docs.rime.ai/
# =============================================
RIME_API_KEY=your_rime_api_key_here
RIME_MODEL_ID=coda
RIME_SPEAKER=celeste
RIME_ENDPOINT=api.rime.ai

# =============================================
# LiveKit Cloud (WebRTC Real-time Transport)
# Sign up at https://cloud.livekit.io (Free tier available)
# =============================================
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# =============================================
# Deepgram STT (Speech-to-Text Transcription)
# Sign up at https://deepgram.com (Free tier available)
# =============================================
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_MODEL=nova-3
# en-US, or "multi" to understand speech that mixes English and Hindi
STT_LANGUAGE=en-US

# =============================================
# LLM Provider (Choose at least ONE: Groq or OpenAI)
# =============================================
# Option 1: Groq (Recommended Free Tier) - https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Option 2: OpenAI - https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Order the providers are tried in, on every reply. Put the one with
# working credits first: an OpenAI key with no credits listed first adds
# seconds of failed retries to every answer before Groq takes over.
LLM_PROVIDERS=groq,openai

# =============================================
# Assistant persona
# =============================================
# Name the assistant uses for itself, and (optionally) what it calls you.
ASSISTANT_NAME=Nova
USER_NAME=
# Used when you ask "what time is it" / "weather" without naming a place.
DEFAULT_LOCATION=Asia/Kolkata
# News edition when no country is named: IN, US or GB.
NEWS_REGION=IN

# =============================================
# Financial Data API (Stock Quotes)
# =============================================
# Finnhub Free Tier (60 calls/min) - https://finnhub.io/
# If omitted, system automatically falls back to yfinance
FINNHUB_API_KEY=your_finnhub_api_key_here

# =============================================
# Application & Security Settings
# =============================================
# Signs the per-session secret keys (any long random string, e.g.
# `python -c "import secrets; print(secrets.token_hex(32))"`).
# If unset, LIVEKIT_API_SECRET is used instead.
SESSION_SIGNING_KEY=

# Bearer token for the admin-only session list (GET /api/sessions).
# Leave empty to disable that endpoint.
ADMIN_TOKEN=

# Set to 1 only behind a reverse proxy that sets X-Forwarded-For
# (Render, Railway, Nginx). Leave empty when running directly.
TRUST_PROXY=

# Allowed HTTP CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# SQLite Database path for session & turn persistence
DATABASE_PATH=data/agent.db

# API Rate Limit (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=60

# Artificial delay in seconds for testing interruption race condition (default 0.0 for production)
ARTIFICIAL_DELAY_SECONDS=0.0

# Logging verbosity (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO